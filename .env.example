# Copie para .env (não versionado) e preencha. Lido pelo docker-compose.
# Gere senhas com: openssl rand -hex 20

POSTGRES_USER=financeai
POSTGRES_PASSWORD=
POSTGRES_DB=financeai

# Senhas dos usuários criados no boot (admin@financeai.com / user@financeai.com).
# Vazio = usuário não é criado. Mudar o valor e reiniciar o backend rotaciona a senha.
# O usuário comum só é criado com APP_ENV=development.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# Origens CORS extras (ex.: IP da rede local para testar no celular)
# FRONTEND_URL=http://localhost:5173,http://localhost:5174

# Testes de integração (go test -tags integration ./...) exigem:
# TEST_DATABASE_URL=postgres://financeai:<senha>@localhost:5432/financeai_test?sslmode=disable
