# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080
APP_ENV=production   # "production" | "development"

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/financeai?sslmode=require

# ── JWT (RS256) ────────────────────────────────────────────────────────────────
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then export the PEM content as a single line with \n separators, or use multiline env.
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── S3-compatible Bucket ───────────────────────────────────────────────────────
AWS_ENDPOINT_URL=https://...
AWS_DEFAULT_REGION=auto
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET_NAME=financeai-images

# ── CORS ───────────────────────────────────────────────────────────────────────
# Aceita uma ou mais origens separadas por vírgula (sem espaço) — por exemplo, o
# frontend financeiro e o dispensaAI, cada um com deploy próprio no Railway.
FRONTEND_URL=https://your-frontend.up.railway.app,https://your-dispensa.up.railway.app

# ── Seed users ─────────────────────────────────────────────────────────────────
# admin@financeai.com is only created when SEED_ADMIN_PASSWORD is set. If the user
# already exists, the password is synced to this value on every boot (rotation).
SEED_ADMIN_PASSWORD=
# user@financeai.com — only with APP_ENV=development
SEED_USER_PASSWORD=

# ── Rate Limiting (optional) ───────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_SECONDS=900
